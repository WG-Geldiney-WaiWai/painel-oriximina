# Fica fora da imagem do Docker
__pycache__/
**/__pycache__/
*.pyc
.vscode/
.git/
backups/
# Contas, senhas, sessões de login, problemas e ocorrências: ficam só na pasta do computador, ligada
# ao container no docker-compose.yml (igual ao .gitignore; só a configuração dos painéis vai junto)
usuarios/*
!usuarios/admin_painel.json
# Arquivos brutos do IBGE (69 MB): não precisam ir na imagem; com o container rodando eles chegam
# pela pasta dados/ ligada no docker-compose.yml (o filtrar_mapa.py lê dali)
dados/fontes/
iniciar.ps1
iniciar.sh
Dockerfile
docker-compose.yml
.dockerignore

# Senhas e chaves (e-mail, API da Anthropic) nunca vão para dentro da imagem:
# passe pelo docker-compose.yml (variáveis de ambiente ou o arquivo ligado ao container)
.streamlit/secrets.toml
.env
